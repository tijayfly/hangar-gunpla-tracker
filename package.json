{
  "name": "hangar-gunpla-tracker",
  "productName": "HANGAR",
  "version": "1.0.1",
  "description": "HANGAR: a local Gunpla collection tracker (Electron)",
  "main": "main.js",
  "author": "TiJayFLY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tijayfly.hangar",
    "productName": "HANGAR",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "data/**"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "HANGAR-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tijayfly/hangar-gunpla-tracker.git"
  }
}
